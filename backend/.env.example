# Plantilla de configuración del backend para el arranque NATIVO (`./mvnw spring-boot:run`).
#
# NO lo consume `docker compose`: Compose lee únicamente el `.env` de la raíz e
# inyecta estas variables al contenedor por su bloque `environment:`. Este archivo
# solo aplica cuando se corre el backend fuera de contenedor.
#
# Todas las variables tienen un valor por defecto operativo en `application.yml` /
# `application-dev.yml`, de modo que el backend arranca en perfil dev sin este
# archivo. Copiar a `.env` y ajustar; `.env` no se versiona.

# --- Perfil ----------------------------------------------------------------
# `dev` (por defecto) o `prod`. En `prod` desaparecen los valores por defecto de
# JWT_SECRET y CORS_ALLOWED_ORIGINS: si faltan, el arranque falla.
SPRING_PROFILES_ACTIVE=dev

# --- Base de datos -------------------------------------------------------------
# Dentro de la red de Compose el host es `db`; en nativo, `localhost`.
DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=optiplant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=optiplant

# --- Servidor ----------------------------------------------------------------
BACKEND_PORT=8080

# --- Seguridad -------------------------------------------------------------
# Clave HMAC-SHA256: mínimo 32 caracteres (256 bits).
# En dev hay un valor por defecto marcado como tal en application-dev.yml.
# En prod NO hay valor por defecto: sin esta variable, el arranque falla.
# JWT_SECRET=

# Orígenes CORS permitidos, separados por coma. Un origen explícito por entrada,
# sin comodín (RNF-SEC-06). En prod NO hay valor por defecto.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Analítica externa -----------------------------------------------------
# Clave de API para CU-EXT-01 (consulta de disponibilidad consolidada).
# Valor de desarrollo en application-dev.yml; se resuelve al usuario semilla
# 'operador.bogota'.
# ANALYTICS_EXTERNAL_API_KEY=
