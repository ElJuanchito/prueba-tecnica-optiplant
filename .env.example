# Plantilla de configuración. Copiar a .env y ajustar; .env no se versiona.
# Cada valor tiene un valor por defecto operativo en application.yml, de modo que
# `docker compose up` funciona sin este archivo.

# --- Base de datos -----------------------------------------------------------
POSTGRES_DB=optiplant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=optiplant

# Puerto en el que la base queda expuesta en la máquina anfitriona.
# Dentro de la red de Compose el backend siempre habla con db:5432.
DB_PORT_HOST=5432

# --- Backend -----------------------------------------------------------------
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Seguridad ---------------------------------------------------------------
# Clave HMAC-SHA256: mínimo 32 caracteres (256 bits).
# En el perfil dev hay un valor por defecto marcado como tal en application-dev.yml.
# En prod NO hay valor por defecto: sin esta variable, el arranque falla.
# Descomentar y reemplazar por una clave real antes de usar el perfil prod.
# JWT_SECRET=

# --- Frontend --------------------------------------------------------------
# Puerto del anfitrión donde se publica la SPA que sirve Nginx (contenedor en
# 8080). Distinto de BACKEND_PORT para no colisionar en el anfitrión.
FRONTEND_PORT=8081
