    {
      "id": "aa4398ccdc350021",
      "type": "text",
      "x": 130,
      "y": 1650,
      "width": 1100,
      "height": 17,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aj",
      "roundness": null,
      "seed": 869305733,
      "version": 1,
      "versionNonce": 1564879543,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1774483200000,
      "link": null,
      "locked": false,
      "text": "•  Separación estricta en tres capas: el frontend no contiene ni una regla de negocio (restricción técnica 1).",
      "originalText": "•  Separación estricta en tres capas: el frontend no contiene ni una regla de negocio (restricción técnica 1).",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "a9b144ae835e6899",
      "type": "text",
      "x": 130,
      "y": 1676,
      "width": 1100,
      "height": 17,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ak",
      "roundness": null,
      "seed": 897322224,
      "version": 1,
      "versionNonce": 547700247,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1774483200000,
      "link": null,
      "locked": false,
      "text": "•  El frontend se comunica con el backend exclusivamente por la API; nunca accede a la base de datos.",
      "originalText": "•  El frontend se comunica con el backend exclusivamente por la API; nunca accede a la base de datos.",
