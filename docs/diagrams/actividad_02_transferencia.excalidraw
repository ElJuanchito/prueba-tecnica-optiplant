    {
      "id": "72f53d6875017794",
      "type": "text",
      "x": 150,
      "y": 2800,
      "width": 1380,
      "height": 17,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1F",
      "roundness": null,
      "seed": 1804716180,
      "version": 1,
      "versionNonce": 1802428033,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1774483200000,
      "link": null,
      "locked": false,
      "text": "•  RN-05 — la máquina de estados es obligatoria: ninguna transferencia puede saltar etapas.",
      "originalText": "•  RN-05 — la máquina de estados es obligatoria: ninguna transferencia puede saltar etapas.",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "a39a8a40a1b80b68",
      "type": "text",
      "x": 150,
      "y": 2824,
      "width": 1380,
      "height": 17,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1G",
      "roundness": null,
      "seed": 141810820,
      "version": 1,
      "versionNonce": 1332336535,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1774483200000,
      "link": null,
      "locked": false,
      "text": "•  RN-04 — el stock en tránsito no es vendible en destino hasta confirmar la recepción.",
      "originalText": "•  RN-04 — el stock en tránsito no es vendible en destino hasta confirmar la recepción.",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "78a63bf7df292ba1",
      "type": "text",
      "x": 150,
      "y": 2848,
      "width": 1380,
      "height": 17,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1H",
      "roundness": null,
      "seed": 755209253,
      "version": 1,
      "versionNonce": 496082644,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1774483200000,
      "link": null,
      "locked": false,
      "text": "•  RN-06 — cantidad recibida más discrepancia debe igualar siempre la cantidad despachada.",
      "originalText": "•  RN-06 — cantidad recibida más discrepancia debe igualar siempre la cantidad despachada.",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
