      "isDeleted": false,
      "boundElements": null,
      "updated": 1774483200000,
      "link": null,
      "locked": false,
      "text": "•  RN-07 — toda discrepancia genera alerta persistente; nunca se resuelve en silencio.",
      "originalText": "•  RN-07 — toda discrepancia genera alerta persistente; nunca se resuelve en silencio.",
